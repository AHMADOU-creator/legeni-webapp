apiVersion: apps/v1
kind: Deployment
metadata: { name: legeni-app, namespace: "{{ namespace }}" }
spec:
  replicas: {{ replicas }}
  strategy:
    type: RollingUpdate
    rollingUpdate: { maxUnavailable: 0, maxSurge: 1 }
  selector: { matchLabels: { app: legeni-app } }
  template:
    metadata: { labels: { app: legeni-app } }
    spec:
      containers:
        - name: app
          image: "{{ image }}:{{ image_tag }}"
          ports: [{ containerPort: 5000 }]
          env:
            - { name: APP_ENV, value: "{{ target_env }}" }
            - { name: APP_VERSION, value: "{{ expected_version }}" }
            - { name: APP_COLOR, value: "{{ app_color }}" }
            - { name: REDIS_HOST, value: redis }
            - name: REDIS_PASSWORD
              valueFrom: { secretKeyRef: { name: redis-secret, key: REDIS_PASSWORD } }
          readinessProbe: { httpGet: { path: "{{ ready_path | default('/ready') }}", port: 5000 }, periodSeconds: 3 }
          livenessProbe: { httpGet: { path: /health, port: 5000 }, initialDelaySeconds: 10 }
          resources:
            requests: { cpu: 50m, memory: 64Mi }
            limits: { cpu: 300m, memory: 192Mi }
---
apiVersion: v1
kind: Service
metadata: { name: legeni-app, namespace: "{{ namespace }}" }
spec:
  type: NodePort
  selector: { app: legeni-app }
  ports: [{ port: 5000, targetPort: 5000, nodePort: {{ node_port }} }]
